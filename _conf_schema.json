{
  "whitelist": {
    "description": "会话白名单",
    "type": "list",
    "default": [],
    "hint": "留空时全部会话可用；群聊填写群号，私聊填写用户 ID。配置后仅允许列表中的会话使用。"
  },
  "strict_mode": {
    "description": "指令默认使用严格模式",
    "type": "bool",
    "default": false,
    "hint": "关闭时 factor=1.2，开启时 factor=1.4。"
  },
  "timeout_seconds": {
    "description": "总请求超时（秒）",
    "type": "int",
    "default": 300,
    "hint": "允许范围 10-600 秒。"
  },
  "cooldown_seconds": {
    "description": "单用户冷却（秒）",
    "type": "int",
    "default": 30,
    "hint": "设为 0 可关闭冷却。"
  },
  "max_concurrency": {
    "description": "最大并发搜索数",
    "type": "int",
    "default": 2,
    "hint": "建议保持 1-2，避免触发网站限流。"
  },
  "max_pending_tasks": {
    "description": "最大待处理任务数",
    "type": "int",
    "default": 20,
    "hint": "超过上限的新请求会立即失败，不会无限排队。"
  },
  "top_k": {
    "description": "网站检索候选数",
    "type": "int",
    "default": 25,
    "hint": "允许范围 1-50。"
  },
  "max_results": {
    "description": "最多展示条数",
    "type": "int",
    "default": 3,
    "min": 1,
    "max": 10,
    "hint": "允许范围 1-10；超过数量时优先展示相似度更高的结果。"
  },
  "min_similarity": {
    "description": "最低相似度（%）",
    "type": "float",
    "default": 80,
    "min": 0,
    "max": 100,
    "hint": "允许范围 0-100；只展示相似度达到此数值的结果。"
  },
  "show_match_page_url": {
    "description": "显示匹配页地址",
    "type": "bool",
    "default": true,
    "hint": "关闭后不在单条结果中显示“匹配页”地址。"
  },
  "show_detail_page_url": {
    "description": "显示详情页地址",
    "type": "bool",
    "default": true,
    "hint": "关闭后不在单条结果中显示“详情页”地址。"
  },
  "show_preview_image": {
    "description": "显示预览图片",
    "type": "bool",
    "default": true,
    "hint": "结果含有预览图时一并发送；关闭后仅发送文字。"
  }
}
